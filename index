<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#08090c">
<title>Nexora — Bienvenue</title>

<style>
/* =================================
   1. CONFIGURATION GÉNÉRALE
================================= */

:root {
    --bg: #08090c;
    --panel: rgba(255,255,255,0.045);
    --panel-hover: rgba(255,255,255,0.085);
    --text: #f5f5f7;
    --muted: #9899a3;
    --border: rgba(255,255,255,0.11);
    --accent: #ffffff;
    --radius: 24px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                 Roboto, Helvetica, Arial, sans-serif;
    color: var(--text);
    background: var(--bg);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

/* Fond lumineux subtil.
   Plus tard, remplace le gradient par ton image si tu le souhaites. */


.background {
    position: fixed;
    inset: 0;
    z-index: -2;

    background: #00152E;
        ),
        linear-gradient(
            135deg,
            #031329 0%,
            #041a36 48%,
            #061b35 75%,
            #031329 100%
        );
}

.background::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        180deg,
        rgba(8, 9, 12, 0.05),
        rgba(8, 9, 12, 0.28)
    );
    pointer-events: none;
}
/* =================================
   2. BARRE DE NAVIGATION
================================= */

.site-header {
    width: 100%;
    padding: 18px 24px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    position: relative;
    z-index: 10;
}

.account-actions {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
}

.account-button {
    min-height: 39px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(90, 155, 255, 0.35);
    background: rgba(40, 115, 235, 0.12);
    color: #8bbcff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
}

.account-button:hover {
    background: rgba(40, 115, 235, 0.25);
    border-color: rgba(110, 175, 255, 0.75);
    color: #c5e0ff;
    transform: translateY(-1px);
}

.account-button:active {
    transform: scale(0.97);
}

.signup-button {
    background: #2878ee;
    color: white;
    border-color: #2878ee;
    box-shadow: 0 4px 20px rgba(40, 120, 238, 0.2);
}

.signup-button:hover {
    background: #428bfa;
    color: white;
    border-color: #428bfa;
}


header {
    width: 100%;
}

.navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 7px;
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(18,19,23,0.78);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 10px 45px rgba(0,0,0,0.18);
}

.nav-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 17px;
    min-height: 42px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: #b4b5be;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
        background 0.28s ease,
        color 0.28s ease,
        border-color 0.28s ease,
        transform 0.22s ease;
}

.nav-button:hover {
    color: white;
    background: rgba(255,255,255,0.07);
}

.nav-button:active {
    transform: scale(0.95);
}

.nav-button.active {
    background: #f3f3f5;
    color: #101115;
    border-color: rgba(255,255,255,0.3);
    box-shadow: 0 2px 12px rgba(255,255,255,0.07);
}

.nav-button svg {
.pro-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px 6px;
    border-radius: 6px;
    background: linear-gradient(135deg, #e8d7a1, #b99a55);
    color: #17140d;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.8px;
    line-height: 1.2;
    box-shadow: 0 0 12px rgba(218, 187, 111, 0.12);
}
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

/* =================================
   3. CONTENU PRINCIPAL
================================= */

main {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
}

.page {
    display: none;
    width: 100%;
    flex: 1;
    animation: pageIn 0.5s cubic-bezier(.2,.75,.25,1) both;
}

.page.active {
    display: flex;
    flex-direction: column;
}

@keyframes pageIn {
    from {
        opacity: 0;
        transform: translateY(13px);
        filter: blur(3px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
    }
}

/* =================================
   4. ACCUEIL
================================= */

.home {
    width: 100%;
    min-height: 650px;
    padding: 80px 24px 95px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
}

.eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #b7b8c1;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 32px;
}

.eyebrow::before,
.eyebrow::after {
    content: "";
    width: 23px;
    height: 1px;
    background: rgba(255,255,255,0.32);
}

.hero-title {
    font-size: clamp(58px, 11vw, 116px);
    line-height: 0.98;
    letter-spacing: -0.085em;
    font-weight: 650;
    text-wrap: balance;
    margin-bottom: 28px;
}

.hero-title span {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 12px;
    text-decoration-color: rgba(255,255,255,0.72);
}

.hero-description {
    max-width: 570px;
    color: #a8a9b3;
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.85;
    font-weight: 400;
    margin-bottom: 35px;
}

.hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
}

/* Boutons */

.button {
    min-height: 49px;
    padding: 0 23px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
        transform 0.22s ease,
        background 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease;
}

.button svg {
    width: 16px;
    height: 16px;
    transition: transform 0.25s ease;
}

.button:hover svg {
    transform: translateX(3px);
}

.button:active {
    transform: scale(0.96);
}

.button-primary {
    color: #101115;
    background: #f5f5f7;
    box-shadow: 0 5px 25px rgba(255,255,255,0.06);
}

.button-primary:hover {
    background: white;
    box-shadow: 0 8px 32px rgba(255,255,255,0.13);
    transform: translateY(-2px);
}

.button-secondary {
    color: #eeeef1;
    background: rgba(255,255,255,0.045);
    border-color: rgba(255,255,255,0.16);
}

.button-secondary:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.3);
    transform: translateY(-2px);
}

/* Petit indicateur en bas de l'accueil */

.scroll-hint {
    position: absolute;
    bottom: 30px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #777984;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.scroll-line {
    width: 30px;
    height: 1px;
    background: #555761;
}

/* =================================
   5. PAGES EN CONSTRUCTION
================================= */

.coming-soon {
    width: 100%;
    flex: 1;
    min-height: 560px;
    padding: 80px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.soon-card {
    width: min(100%, 650px);
    padding: 62px 30px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 32px;
    background: linear-gradient(
        145deg,
        rgba(255,255,255,0.055),
        rgba(255,255,255,0.018)
    );
    box-shadow: 0 25px 100px rgba(0,0,0,0.2);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
}

.soon-icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 28px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.055);
    color: #eeeeF3;
}

.soon-icon svg {
    width: 25px;
    height: 25px;
}

.soon-label {
    color: #a6a7b0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 17px;
}

.soon-card h1 {
    font-size: clamp(34px, 6vw, 55px);
    line-height: 1.1;
    letter-spacing: -0.055em;
    margin-bottom: 18px;
    font-weight: 600;
}

.soon-card p {
    max-width: 420px;
    margin: 0 auto 28px;
    color: var(--muted);
    line-height: 1.8;
    font-size: 14px;
}

.status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 16px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    color: #d3d3da;
    background: rgba(255,255,255,0.035);
    font-size: 11px;
    letter-spacing: 0.3px;
}

.status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b9bac3;
    box-shadow: 0 0 10px rgba(255,255,255,0.25);
}

/* =================================
   6. FOOTER
================================= */

footer {
    width: 100%;
    padding: 24px 32px;
    border-top: 1px solid rgba(255,255,255,0.09);
    background: rgba(7,8,11,0.55);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
}

.footer-inner {
    width: min(100%, 1180px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.footer-copy {
    color: #777984;
    font-size: 11px;
    line-height: 1.8;
}

.footer-copy strong {
    color: #c4c5cd;
    font-weight: 600;
}

.footer-center {
    display: flex;
    align-items: center;
    gap: 8px;
}

.footer-label {
    margin-right: 5px;
    color: #a2a3ad;
    font-size: 11px;
}

.social-link {
    width: 37px;
    height: 37px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #b8b9c2;
    border: 1px solid rgba(255,255,255,0.11);
    border-radius: 50%;
    background: rgba(255,255,255,0.035);
    transition:
        color 0.25s ease,
        background 0.25s ease,
        border-color 0.25s ease,
        transform 0.25s ease;
}

.social-link:hover {
    color: white;
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.28);
    transform: translateY(-3px);
}

.social-link svg {
    width: 17px;
    height: 17px;
}

.footer-email {
    color: #b8b9c2;
    text-decoration: none;
    font-size: 11px;
    transition: color 0.2s ease;
}

.footer-email:hover {
    color: white;
}

/* =================================
   7. ACCESSIBILITÉ
================================= */

button:focus-visible,
a:focus-visible {
    outline: 2px solid white;
    outline-offset: 4px;
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}

/* =================================
   8. ADAPTATION AUX PETITS ÉCRANS
================================= */

@media (max-width: 1050px) {
    header {
        padding: 20px 15px 0;
    }

    .navigation {
        flex-wrap: wrap;
        border-radius: 25px;
        max-width: 850px;
    }

    .nav-button {
        padding: 11px 14px;
        font-size: 12px;
    }
}

@media (max-width: 620px) {
    header {
        padding: 14px 10px 0;
    }

    .navigation {
        width: 100%;
        gap: 4px;
        padding: 6px;
        border-radius: 22px;
    }

    .nav-button {
        flex: 1 1 calc(33.333% - 6px);
        padding: 10px 5px;
        min-height: 40px;
        font-size: 11px;
        gap: 5px;
    }

    .nav-button svg {
        width: 14px;
        height: 14px;
    }

    .home {
        min-height: 580px;
        padding: 75px 20px 90px;
    }

    .eyebrow {
        font-size: 9px;
        letter-spacing: 2px;
        margin-bottom: 27px;
    }

    .hero-title {
        font-size: clamp(52px, 16vw, 80px);
        margin-bottom: 25px;
    }

    .hero-title span {
        text-underline-offset: 8px;
        text-decoration-thickness: 2px;
    }

    .hero-description {
        font-size: 14px;
        line-height: 1.8;
    }

    .button {
        min-height: 46px;
        padding: 0 17px;
        font-size: 12px;
    }

    .coming-soon {
        min-height: 470px;
        padding: 55px 16px;
    }

    .soon-card {
        padding: 45px 20px;
        border-radius: 25px;
    }

    footer {
        padding: 22px 18px;
    }

    .footer-inner {
        flex-direction: column;
        text-align: center;
        gap: 17px;
    }

    .footer-center {
        flex-wrap: wrap;
        justify-content: center;
    }

.site-header {
    padding: 12px 10px 0;
    gap: 12px;
}

.account-actions {
    flex-wrap: wrap;
    gap: 7px;
}

.account-button {
    padding: 0 11px;
    font-size: 11px;
}

.navigation {
    width: 100%;
}

}

/* NEXORA PRO */

.pro-page {
    width: 100%;
    padding: 75px 24px 100px;
    text-align: center;
    animation: pageIn 0.5s ease both;
}

.pro-eyebrow,
.benefits-eyebrow {
    color: #d9c28c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
}

.pro-crown {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    margin-right: 7px;
    border: 1px solid rgba(217,194,140,.35);
    border-radius: 9px;
    background: rgba(217,194,140,.08);
}

.pro-title {
    margin: 24px 0 20px;
    font-size: clamp(42px, 7vw, 76px);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 1.06;
}

.pro-title span {
    color: #c6b17c;
}

.pro-description {
    max-width: 510px;
    margin: 0 auto 38px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.8;
}

.price-card {
    width: min(100%, 410px);
    margin: 0 auto;
    padding: 29px;
    text-align: left;
    border: 1px solid rgba(217,194,140,.28);
    border-radius: 27px;
    background:
        radial-gradient(ellipse at top right,
            rgba(178,148,80,.12), transparent 65%),
        rgba(255,255,255,.045);
    box-shadow: 0 25px 90px rgba(0,0,0,.22);
    backdrop-filter: blur(18px);
}

.price-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.price-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #d8d8df;
}

.price-tag {
    padding: 5px 8px;
    border: 1px solid rgba(217,194,140,.3);
    border-radius: 7px;
    color: #d9c28c;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
}

.price {
    margin-top: 28px;
}

.price-number {
    font-size: 48px;
    font-weight: 650;
    letter-spacing: -2.5px;
}

.price-note {
    margin-top: 7px;
    color: #92939e;
    font-size: 11px;
    line-height: 1.6;
}

.buy-button {
    width: 100%;
    margin-top: 25px;
    background: linear-gradient(135deg, #e5d3a0, #c1a45e);
    color: #19150b;
    box-shadow: 0 7px 25px rgba(193,164,94,.12);
}

.buy-button:hover {
    background: linear-gradient(135deg, #f1e1b3, #d4b874);
    transform: translateY(-2px);
}

.buy-notice {
    margin-top: 18px;
    text-align: center;
    color: #e4d5ab;
    font-size: 13px;
}

.benefits-section {
    width: min(100%, 1000px);
    margin: 95px auto 0;
}

.benefits-section h2 {
    margin: 17px 0 15px;
    font-size: clamp(28px, 4vw, 42px);
    letter-spacing: -1.5px;
}

.benefits-intro {
    max-width: 510px;
    margin: 0 auto 32px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
}

.benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
    text-align: left;
}

.benefit-card {
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: 21px;
    background: rgba(255,255,255,.035);
    transition: transform .25s ease,
                background .25s ease,
                border-color .25s ease;
}

.benefit-card:hover {
    transform: translateY(-4px);
    background: rgba(255,255,255,.065);
    border-color: rgba(217,194,140,.28);
}

.benefit-number {
    color: #c6b17c;
    font-size: 11px;
    letter-spacing: 2px;
}

.benefit-card h3 {
    margin: 19px 0 9px;
    font-size: 16px;
}

.benefit-card p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

@media (max-width: 620px) {
    .pro-page {
        padding: 55px 17px 70px;
    }

    .price-card {
        padding: 23px;
    }

    .benefits-section {
        margin-top: 65px;
    }

    .benefits-grid {
        grid-template-columns: 1fr;
    }
}

/* CONNEXION ET INSCRIPTION */

.auth-page {
    width: 100%;
    flex: 1;
    min-height: 560px;
    padding: 65px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.auth-card {
    width: min(100%, 460px);
    padding: 38px;
    border: 1px solid var(--border);
    border-radius: 27px;
    background: rgba(18,19,26,.78);
    box-shadow: 0 25px 90px rgba(0,0,0,.25);
    backdrop-filter: blur(20px);
}

.auth-eyebrow {
    color: #8bbcff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.5px;
    margin-bottom: 22px;
}

.auth-card h1 {
    font-size: clamp(30px, 5vw, 40px);
    letter-spacing: -1.5px;
    line-height: 1.15;
}

.auth-description {
    margin: 14px 0 28px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
}

.auth-card form {
    display: flex;
    flex-direction: column;
    gap: 11px;
}

.auth-card label {
    margin-top: 7px;
    color: #d8d9e0;
    font-size: 12px;
    font-weight: 500;
}

.auth-card input {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 12px;
    background: rgba(255,255,255,.045);
    color: white;
    font: inherit;
    font-size: 13px;
    outline: none;
    transition: border-color .2s ease,
                background .2s ease;
}

.auth-card input::placeholder {
    color: #777984;
}

.auth-card input:focus {
    border-color: #5598ff;
    background: rgba(255,255,255,.065);
}

.auth-submit {
    width: 100%;
    min-height: 48px;
    margin-top: 14px;
    border: 1px solid #2878ee;
    border-radius: 12px;
    background: #2878ee;
    color: white;
    font: inherit;
    font-size: 13px;
    font-weight: 650;
    cursor: pointer;
    transition: background .2s ease,
                transform .2s ease;
}

.auth-submit:hover {
    background: #428bfa;
    transform: translateY(-1px);
}

.auth-submit:active {
    transform: scale(.98);
}

.auth-message {
    margin-top: 18px;
    color: #a9caff;
    font-size: 12px;
    line-height: 1.7;
}

@media (max-width: 620px) {
    .auth-page {
        padding: 40px 16px;
    }

    .auth-card {
        padding: 27px 21px;
    }
}

/* LOGO NEXORA */

.nexora-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: clamp(46px, 9vw, 94px);
    font-weight: 500;
    letter-spacing: 0.13em;
    line-height: 1.2;
    color: #f5f7ff;
    text-shadow: 0 0 20px rgba(215, 230, 255, 0.12);
    margin-bottom: 28px;
}


.nexora-logo .nexora-o {
    display: inline-block;
    position: relative;
    color: #20cfff;
    text-decoration: none;
    text-shadow:
        0 0 5px rgba(32, 207, 255, 0.65),
        0 0 15px rgba(32, 207, 255, 0.3);
    animation: none;
}


    50% {
        text-shadow:
            0 0 8px rgba(32, 207, 255, 1),
            0 0 22px rgba(32, 207, 255, 0.9),
            0 0 42px rgba(32, 207, 255, 0.5);
    }
}

/* Retire le soulignement du titre précédent */
.nexora-logo span {
    text-decoration: none;
}

@media (max-width: 620px) {
    .nexora-logo {
        font-size: clamp(36px, 10vw, 60px);
        letter-spacing: 0.09em;
    }
}

/* FOOTER PREMIUM NEXORA */

.nexora-footer {
    position: relative;
    width: 100%;
    margin-top: auto;
    color: #e8f1ff;
    background:
        radial-gradient(
            ellipse at 15% 100%,
            rgba(0, 95, 210, 0.13),
            transparent 55%
        ),
        linear-gradient(
            110deg,
            #031329 0%,
            #041a36 52%,
            #03152c 100%
        );
    border-top: 1px solid rgba(26, 132, 255, 0.35);
}

.footer-top-line {
    height: 1px;
    width: 100%;
    background: linear-gradient(
        90deg,
        transparent,
        #087fff,
        #16d6ff,
        #087fff,
        transparent
    );
    opacity: 0.75;
}

.footer-layout {
    width: min(100%, 1450px);
    margin: 0 auto;
    padding: 38px 34px;
    display: grid;
    grid-template-columns: 1.15fr 1.55fr .75fr .85fr 1fr;
    align-items: start;
    gap: 30px;
}

.footer-brand {
    padding-top: 12px;
}

.footer-brand-name {
    display: flex;
    align-items: center;
    gap: 10px;
}

.footer-n {
    font-size: 48px;
    line-height: 1;
    font-weight: 800;
    font-style: italic;
    letter-spacing: -6px;
    background: linear-gradient(
        135deg,
        #24e1ff,
        #087cff 60%,
        #0064d9
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.footer-word {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 5px;
    white-space: nowrap;
    color: #f2f7ff;
}

.footer-word span {
    color: #1bd5ff;
    text-shadow: 0 0 10px rgba(27,213,255,.4);
}

.footer-tagline {
    margin-top: 13px;
    color: #9dc9ff;
    font-size: 8px;
    letter-spacing: 2.6px;
    white-space: nowrap;
}

.footer-presentation h3 {
    margin-bottom: 9px;
    color: #f5f8ff;
    font-size: 14px;
    font-weight: 650;
}

.footer-presentation p {
    max-width: 270px;
    margin-bottom: 15px;
    color: #a9c4e6;
    font-size: 11px;
    line-height: 1.8;
}

.footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 36px;
    padding: 0 17px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(100deg, #079aff, #0874ee);
    color: white;
    font: inherit;
    font-size: 10px;
    font-weight: 650;
    cursor: pointer;
    transition: transform .22s ease,
                box-shadow .22s ease;
}

.footer-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 22px rgba(0,125,255,.3);
}

.footer-cta span {
    font-size: 16px;
}

.footer-column {
    min-height: 100px;
    padding-left: 20px;
    border-left: 1px solid rgba(61, 142, 231, .22);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
}

.footer-column h4 {
    margin-bottom: 3px;
    color: #20cfff;
    font-size: 11px;
    font-weight: 650;
}

.footer-column button,
.footer-column a {
    padding: 0;
    border: 0;
    background: transparent;
    color: #c3d6ed;
    font-family: inherit;
    font-size: 10px;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: color .2s ease;
}

.footer-column button:hover,
.footer-column a:hover {
    color: white;
}

.footer-social {
    min-height: 100px;
    padding-left: 20px;
    border-left: 1px solid rgba(61, 142, 231, .22);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.footer-social-icons {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 10px 0 23px;
}

.footer-social-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 19px;
    height: 24px;
    color: #36caff;
    font-size: 19px;
    font-weight: 700;
    text-decoration: none;
    transition: transform .2s ease, color .2s ease;
}

.footer-social-icons a:hover {
    color: white;
    transform: translateY(-2px);
}

.footer-contact {
    color: #a9c4e6;
    font-size: 10px;
    text-decoration: none;
}

.footer-contact:hover {
    color: white;
}

.footer-copyright {
    margin-top: 16px;
    color: #86a4c9;
    font-size: 9px;
    line-height: 1.7;
}

@media (max-width: 1050px) {
    .footer-layout {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 30px 22px;
    }

    .footer-social {
        grid-column: auto;
    }
}

@media (max-width: 620px) {
    .footer-layout {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        padding: 30px 20px;
        gap: 28px 18px;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-presentation {
        grid-column: 1 / -1;
    }

    .footer-column,
    .footer-social {
        padding-left: 12px;
    }

    .footer-word {
        font-size: 17px;
        letter-spacing: 4px;
    }
}
