    const lowerText = text.toLowerCase();
    const replies = [];

    if (
        lowerText.includes("site") ||
        lowerText.includes("html") ||
        lowerText.includes("css") ||
        lowerText.includes("javascript")
    ) {
        replies.push(
            "Pour ton site web, on peut avancer étape par étape :\n\n1. HTML pour la structure.\n2. CSS pour le design.\n3. JavaScript pour les interactions.\n\nTu veux travailler sur quelle partie en premier ?"
        );
    }

    if (
        lowerText.includes("code") ||
        lowerText.includes("programmer") ||
        lowerText.includes("développer") ||
        lowerText.includes("python")
    ) {
        replies.push(
            "On va progresser en programmation ! Le plus simple est de partir d'un petit objectif, puis de tester le code.\n\nTu préfères apprendre les bases, corriger un bug ou créer un petit projet ?"
        );
    }

    if (
        lowerText.includes("projet") ||
        lowerText.includes("organiser") ||
        lowerText.includes("planning")
    ) {
        replies.push(
            "Pour organiser ton projet, commence par noter le résultat que tu veux obtenir.\n\nEnsuite, découpe-le en petites tâches et choisis la première action réalisable aujourd'hui.\n\nQuel est ton objectif principal ?"
        );
    }

    if (
        lowerText.includes("devoir") ||
        lowerText.includes("cours") ||
        lowerText.includes("exercice") ||
        lowerText.includes("réviser")
    ) {
        replies.push(
            "Je peux t'aider à comprendre ton cours ou à aborder un exercice étape par étape.\n\nEnvoie la consigne ou explique ce qui te bloque, et on cherchera la méthode ensemble."
        );
    }

    if (
        lowerText.includes("bonjour") ||
        lowerText.includes("salut") ||
        lowerText.includes("coucou")
    ) {
        replies.push(
            "Salut ! 😊 Bienvenue sur Nexora AI. Tu peux me parler d'un site web, de programmation, d'un projet ou d'un sujet à apprendre. Par quoi commence-t-on ?"
        );
    }

    if (
        lowerText.includes("merci") ||
        lowerText.includes("super") ||
        lowerText.includes("génial")
    ) {
        replies.push(
            "Avec plaisir ! 😊 On continue quand tu veux. Quelle est la prochaine étape que tu aimerais accomplir ?"
        );
    }

    if (replies.length > 0) {
        return replies[Math.floor(Math.random() * replies.length)];
    }

    return (
        "Merci pour ton message ! 😊 Je suis encore en version de démonstration, mais je peux déjà t'aider à réfléchir à un site web, apprendre à coder, organiser un projet ou réviser un cours.\n\nDis-moi ce que tu veux obtenir et ce qui te bloque : on cherchera ensemble une première étape concrète."
    );
}


function aiSendMessage(text) {
    const cleanText = text.trim();

    if (!cleanText) return;

    aiAddMessage(cleanText, "user");
    aiInput.value = "";
    aiInput.focus();

    // Réponse de démonstration : ce n'est pas encore une véritable IA.
    aiAddMessage(aiDemoReply(cleanText), "bot");
}
if (aiForm && aiInput && aiChat) {
    aiForm.addEventListener("submit", function(event) {
        event.preventDefault();
        aiSendMessage(aiInput.value);
    });

    aiInput.addEventListener("keydown", function(event) {
        if (event.key === "Enter" && !event.shiftKey) {
            event.preventDefault();
            aiForm.requestSubmit();
        }
    });
}
function aiUseSuggestion(text) {
    const input = document.getElementById("aiInput");

    if (!input) return;

    input.value = text;
    input.focus();
    aiSendMessage(text);
}

</script>


