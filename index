<script>
window.NEXORA_PRO_ACTIVE = false; // À remplacer par une validation serveur après paiement réel.
const navButtons = document.querySelectorAll(".nav-button");
const pages = document.querySelectorAll(".page");
const goButtons = document.querySelectorAll("[data-go]");

function showPage(pageId) {
    const targetPage = document.getElementById(pageId);

    if (!targetPage) return;

    // Accès premium : l'état doit être confirmé par le serveur de paiement.
    const premiumPages = ["createurs", "web", "studio"];
    if (premiumPages.includes(pageId) && !window.NEXORA_PRO_ACTIVE) {
        pageId = "pro";
        const notice = document.getElementById("proAccessNotice");
        if (notice) notice.hidden = false;
    }

    // Masque toutes les pages
    pages.forEach(page => {
        page.classList.remove("active");
    });

    // Affiche la page choisie
    targetPage.classList.add("active");

    // Actualise l'onglet sélectionné
    navButtons.forEach(button => {
        const isActive = button.dataset.page === pageId;

        button.classList.toggle("active", isActive);
        button.setAttribute("aria-current", isActive ? "page" : "false");
    });

    // Retour en haut sans recharger le site
    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

// Les paiements ne sont pas encore connectés : ne jamais activer PRO côté navigateur.
document.querySelectorAll(".buy-button[data-plan]").forEach(button => {
