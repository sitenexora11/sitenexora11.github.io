/* ===== NEXORA AI ===== */


/* ===== NEXORA AI — STYLE FUTURISTE ===== */

.nexora-ai {
    position: relative;
    isolation: isolate;
    width: min(900px, 92%);
    margin: 38px auto;
    padding: 26px;
    overflow: hidden;
    color: #f4f7ff;
    font-family: inherit;
    background:
        radial-gradient(ellipse at 100% 0%, rgba(0, 112, 255, 0.17), transparent 42%),
        radial-gradient(ellipse at 0% 100%, rgba(0, 195, 255, 0.08), transparent 38%),
        linear-gradient(145deg, #071225, #030916 70%);
    border: 1px solid rgba(50, 155, 255, 0.25);
    border-radius: 26px;
    box-shadow:
        0 0 45px rgba(0, 100, 255, 0.09),
        0 24px 70px rgba(0, 0, 0, 0.25);
}

.nexora-ai::before {
    content: "";
    position: absolute;
    top: 0;
    left: 8%;
    width: 84%;
    height: 1px;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(36, 155, 255, 0.8),
        transparent
    );
    pointer-events: none;
}

.ai-header {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 25px;
}

.ai-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border: 1px solid rgba(50, 190, 255, 0.55);
    border-radius: 18px;
    background: linear-gradient(
        145deg,
        rgba(0, 130, 255, 0.24),
        rgba(0, 35, 85, 0.55)
    );
    color: #55d8ff;
    font-size: 32px;
    box-shadow:
        0 0 25px rgba(0, 145, 255, 0.2),
        inset 0 0 18px rgba(0, 145, 255, 0.08);
}

.ai-header h1 {
    margin: 0 0 5px;
    font-size: clamp(25px, 4vw, 35px);
    letter-spacing: -0.7px;
    text-shadow: 0 0 22px rgba(30, 145, 255, 0.15);
}

.ai-header p {
    margin: 0;
    color: #aebfd9;
    font-size: 14px;
    line-height: 1.6;
}

.ai-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    padding: 8px 12px;
    border: 1px solid rgba(66, 230, 164, 0.18);
    border-radius: 999px;
    background: rgba(25, 180, 120, 0.06);
    color: #b6d8d2;
    font-size: 12px;
}

.ai-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #42e6a4;
    box-shadow: 0 0 12px rgba(66, 230, 164, 0.7);
}

.ai-chat {
    min-height: 310px;
    max-height: 470px;
    overflow-y: auto;
    padding: 22px;
    border: 1px solid rgba(65, 145, 255, 0.22);
    border-radius: 20px;
    background:
        radial-gradient(ellipse at 0% 0%, rgba(0, 100, 255, 0.08), transparent 50%),
        rgba(2, 10, 25, 0.8);
    box-shadow: inset 0 0 35px rgba(0, 65, 150, 0.07);
    scrollbar-color: #176acb #071225;
    scrollbar-width: thin;
}

.ai-message {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 20px;
}

.ai-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: 1px solid rgba(80, 190, 255, 0.35);
    border-radius: 13px;
    background: linear-gradient(135deg, #087bff, #11c8e8);
    color: white;
    font-weight: 800;
    box-shadow: 0 0 18px rgba(0, 130, 255, 0.22);
}

.ai-bubble {
    max-width: 85%;
    padding: 16px 18px;
    border: 1px solid rgba(90, 155, 235, 0.19);
    border-radius: 5px 17px 17px 17px;
    background: linear-gradient(
        135deg,
        rgba(30, 65, 115, 0.32),
        rgba(10, 25, 50, 0.65)
    );
    line-height: 1.7;
    overflow-wrap: anywhere;
}

.ai-bubble strong {
    color: #59d8ff;
}

.ai-bubble p {
    margin: 9px 0 0;
    color: #d5e2f5;
}

.ai-user {
    justify-content: flex-end;
}

.ai-user .ai-bubble {
    border-color: rgba(35, 160, 255, 0.35);
    border-radius: 17px 5px 17px 17px;
    background: linear-gradient(
        135deg,
        rgba(0, 105, 235, 0.3),
        rgba(0, 55, 125, 0.28)
    );
}

.ai-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0;
}

.ai-suggestion {
    padding: 11px 15px;
    border: 1px solid rgba(65, 155, 255, 0.3);
    border-radius: 13px;
    background: rgba(15, 65, 125, 0.2);
    color: #dceaff;
    cursor: pointer;
    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
}

.ai-suggestion:hover {
    background: rgba(20, 110, 220, 0.25);
    border-color: rgba(70, 190, 255, 0.75);
    box-shadow: 0 0 18px rgba(0, 120, 255, 0.12);
    transform: translateY(-2px);
}

.ai-input-area {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    padding: 12px;
    border: 1px solid rgba(55, 155, 255, 0.4);
    border-radius: 19px;
    background: rgba(2, 10, 25, 0.88);
    box-shadow:
        0 0 25px rgba(0, 100, 255, 0.08),
        inset 0 0 18px rgba(0, 75, 160, 0.05);
    transition: border-color 0.2s, box-shadow 0.2s;
}

.ai-input-area:focus-within {
    border-color: rgba(55, 185, 255, 0.8);
    box-shadow:
        0 0 25px rgba(0, 125, 255, 0.13),
        inset 0 0 18px rgba(0, 75, 160, 0.06);
}

.ai-input-area textarea {
    flex: 1;
    min-width: 0;
    max-height: 140px;
    resize: vertical;
    padding: 10px;
    border: none;
    outline: none;
    background: transparent;
    color: #f4f7ff;
    font: inherit;
    line-height: 1.6;
}

.ai-input-area textarea::placeholder {
    color: #8298b9;
}

.ai-input-area button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    flex-shrink: 0;
    border: 1px solid rgba(130, 220, 255, 0.3);
    border-radius: 14px;
    background: linear-gradient(135deg, #087bff, #12c8e8);
    color: white;
    font-size: 22px;
    cursor: pointer;
    box-shadow: 0 0 18px rgba(0, 130, 255, 0.2);
    transition: filter 0.2s, transform 0.2s;
}

.ai-input-area button:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
}

.ai-disclaimer {
    margin-top: 15px;
    color: #8498b8;
    font-size: 11px;
    line-height: 1.6;
    text-align: center;
}

@media (max-width: 600px) {
    .nexora-ai {
        width: 94%;
        margin: 22px auto;
        padding: 15px;
        border-radius: 21px;
    }

    .ai-header {
        gap: 12px;
    }

    .ai-status {
        margin-left: 0;
    }

    .ai-chat {
        min-height: 280px;
        padding: 14px;
    }

    .ai-message {
        gap: 9px;
    }

    .ai-avatar {
        width: 33px;
        height: 33px;
        border-radius: 11px;
    }

    .ai-bubble {
        max-width: 95%;
        padding: 13px;
        font-size: 14px;
    }

    .ai-suggestions {
        gap: 8px;
    }

    .ai-suggestion {
        padding: 9px 11px;
        font-size: 12px;
    }

    .ai-input-area {
        gap: 8px;
        padding: 8px;
    }

    .ai-input-area button {
        width: 41px;
        height: 41px;
    }
}

    .ai-status {
        margin-left: 0;
    }

    .ai-chat {
        padding: 14px;
    }

    .ai-bubble {
        max-width: 95%;
        padding: 13px;
    }

    .ai-suggestion {
        font-size: 12px;
    }
}
