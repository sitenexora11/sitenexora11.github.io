/* NEXORA STUDIO */
.studio-shell { max-width: 1180px; margin: 0 auto; padding: 28px 18px 60px; }
.studio-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:18px; flex-wrap:wrap; margin-bottom:22px; }
.studio-heading h1 { font-size:clamp(30px,5vw,48px); letter-spacing:-1.8px; }
.studio-heading p { color:var(--muted); margin-top:8px; max-width:620px; line-height:1.6; }
.studio-layout { display:grid; grid-template-columns:minmax(0,1.7fr) minmax(250px,.8fr); gap:16px; }
.studio-panel { background:var(--panel); border:1px solid var(--border); border-radius:20px; padding:16px; min-width:0; }
.studio-panel h2 { font-size:15px; margin-bottom:14px; }
.studio-preview { position:relative; display:grid; place-items:center; overflow:hidden; min-height:260px; aspect-ratio:16/9; background:#050609; border:1px solid var(--border); border-radius:14px; color:#858792; }
.studio-preview video { width:100%; height:100%; max-height:520px; object-fit:contain; display:none; }
.studio-placeholder { text-align:center; padding:24px; line-height:1.7; }
.studio-overlay { position:absolute; left:7%; right:7%; bottom:12%; text-align:center; color:white; font-size:clamp(18px,3vw,36px); font-weight:800; text-shadow:0 3px 12px #000; pointer-events:none; overflow-wrap:anywhere; }
.studio-controls { display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin-top:13px; }
.studio-controls button,.studio-action { border:1px solid var(--border); border-radius:10px; background:var(--panel-hover); color:var(--text); padding:10px 13px; cursor:pointer; font:inherit; }
.studio-controls button:hover,.studio-action:hover { background:rgba(255,255,255,.14); }
.studio-controls input[type=range] { flex:1; min-width:120px; accent-color:var(--text); }
.studio-field { display:grid; gap:7px; margin-bottom:14px; }
.studio-field label { color:var(--muted); font-size:12px; }
.studio-field input,.studio-field select { width:100%; border:1px solid var(--border); border-radius:10px; padding:11px 12px; background:rgba(0,0,0,.2); color:var(--text); font:inherit; }
.studio-field input[type=file] { padding:9px; }
.studio-field input[type=color] { height:42px; padding:4px; }
.studio-timeline { margin-top:16px; }
.studio-track { min-height:54px; border:1px dashed var(--border); border-radius:11px; padding:10px; color:var(--muted); font-size:12px; display:flex; align-items:center; gap:10px; }
.studio-clip { background:rgba(110,150,255,.2); border:1px solid rgba(130,165,255,.4); color:var(--text); border-radius:8px; padding:10px 12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.studio-note { color:var(--muted); font-size:12px; line-height:1.6; margin-top:12px; }
.studio-status { color:var(--muted); font-size:12px; margin-top:10px; min-height:18px; }
@media(max-width:800px){ .studio-layout{grid-template-columns:1fr;} .studio-preview{min-height:190px;} .navigation{overflow-x:auto; justify-content:flex-start;} }


