// NEXORA STUDIO — première version de prévisualisation
(() => {
    const fileInput = document.getElementById("studioFile");
    if (!fileInput) return;
    const video = document.getElementById("studioVideo");
    const placeholder = document.getElementById("studioPlaceholder");
    const titleInput = document.getElementById("studioTitle");
    const overlay = document.getElementById("studioOverlay");
    const colorInput = document.getElementById("studioTitleColor");
    const sizeInput = document.getElementById("studioTitleSize");
    const playButton = document.getElementById("studioPlay");
    const seek = document.getElementById("studioSeek");
    const timeLabel = document.getElementById("studioTime");
    const durationLabel = document.getElementById("studioDuration");
    const clip = document.getElementById("studioClip");
    const status = document.getElementById("studioStatus");
    let mediaUrl = null;
    let mediaName = "";

    const formatTime = seconds => {
        if (!Number.isFinite(seconds)) return "00:00";
        const m = Math.floor(seconds / 60).toString().padStart(2, "0");
        const s = Math.floor(seconds % 60).toString().padStart(2, "0");
        return `${m}:${s}`;
    };

    fileInput.addEventListener("change", () => {
        const file = fileInput.files && fileInput.files[0];
        if (!file) return;
        if (mediaUrl) URL.revokeObjectURL(mediaUrl);
        mediaUrl = URL.createObjectURL(file);
        mediaName = file.name;
        video.src = mediaUrl;
        video.style.display = "block";
        placeholder.style.display = "none";
        clip.textContent = file.name;
        status.textContent = "Vidéo importée. Tu peux lancer la lecture et ajouter un titre.";
        video.load();
    });

    titleInput.addEventListener("input", () => { overlay.textContent = titleInput.value; });
    colorInput.addEventListener("input", () => { overlay.style.color = colorInput.value; });
    sizeInput.addEventListener("change", () => { overlay.style.fontSize = `${sizeInput.value}px`; });

    playButton.addEventListener("click", async () => {
        if (!video.src) { status.textContent = "Importe d'abord une vidéo."; return; }
        if (video.paused) {
            try { await video.play(); } catch (_) { status.textContent = "La lecture n'a pas pu démarrer."; }
        } else video.pause();
    });
    video.addEventListener("play", () => { playButton.textContent = "Ⅱ Pause"; });
    video.addEventListener("pause", () => { playButton.textContent = "▶ Lire"; });
    video.addEventListener("loadedmetadata", () => {
        durationLabel.textContent = formatTime(video.duration);
        seek.max = Math.max(1, Math.floor(video.duration));
    });
    video.addEventListener("timeupdate", () => {
        timeLabel.textContent = formatTime(video.currentTime);
        if (Number.isFinite(video.duration) && video.duration > 0) seek.value = Math.floor(video.currentTime);
    });
    seek.addEventListener("input", () => { if (video.duration) video.currentTime = Number(seek.value); });

    document.getElementById("studioSave").addEventListener("click", () => {
        const project = {
            app: "Nexora Studio",
            version: 1,
            mediaFileName: mediaName,
            title: titleInput.value,
            titleColor: colorInput.value,
            titleSize: Number(sizeInput.value)
        };
        const blob = new Blob([JSON.stringify(project, null, 2)], {type:"application/json"});
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "mon-projet-nexora.json";
        a.click();
        URL.revokeObjectURL(url);
        status.textContent = "Réglages du projet enregistrés.";
    });

    document.getElementById("studioReset").addEventListener("click", () => {
        video.pause();
        video.removeAttribute("src");
        video.load();
        if (mediaUrl) URL.revokeObjectURL(mediaUrl);
        mediaUrl = null;
        mediaName = "";
        fileInput.value = "";
        titleInput.value = "";
        overlay.textContent = "";
        overlay.style.color = "#ffffff";
        overlay.style.fontSize = "36px";
        colorInput.value = "#ffffff";
        sizeInput.value = "36";
        video.style.display = "none";
        placeholder.style.display = "block";
        clip.textContent = "Aucun média importé";
        seek.value = 0;
        timeLabel.textContent = "00:00";
        durationLabel.textContent = "00:00";
        status.textContent = "Projet réinitialisé.";
    });
})();

