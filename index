/* Envoi de l'adresse, du pseudo et du mot de passe au serveur */
document.getElementById("signupDetailsForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = document.getElementById("signupEmail").value.trim();
    const username = document.getElementById("signupUsername").value.trim();
    const password = document.getElementById("signupPassword").value;
    const message = document.getElementById("signupMessage");
    const button = event.currentTarget.querySelector('button[type="submit"]');
    if (!event.currentTarget.checkValidity()) { event.currentTarget.reportValidity(); return; }
    message.hidden = false;
    message.textContent = "Création du compte…";
    button.disabled = true;
    try {
        const response = await fetch("/api/register", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({email, username, password})
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Création du compte impossible.");
        message.textContent = "Compte créé ! Bienvenue " + data.username + ". Tu es maintenant connecté.";
        document.getElementById("signupPassword").value = "";
        await refreshAccountStatus();
    } catch (error) {
        message.textContent = error.message || "Impossible de joindre le serveur. Vérifie que Flask est lancé.";
    } finally {
        button.disabled = false;
    }
});


async function refreshAccountStatus() {
    try {
        const response = await fetch("/api/me");
        const data = await response.json();

        const loginButton = document.getElementById("loginNavButton");
        const signupButton = document.getElementById("signupNavButton");
        const profileButton = document.getElementById("profileNavButton");
        const profileUsername = document.getElementById("profileNavUsername");

        if (!loginButton || !signupButton || !profileButton || !profileUsername) {
            return;
        }

        if (data.logged_in) {
            loginButton.hidden = true;
            signupButton.hidden = true;
            profileButton.hidden = false;
            profileUsername.textContent = data.username;
        } else {
            loginButton.hidden = false;
            signupButton.hidden = false;
            profileButton.hidden = true;
        }
    } catch (error) {
        console.error("Impossible de vérifier la connexion :", error);
    }
}

