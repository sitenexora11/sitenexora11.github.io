const esc=v=>String(v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function showGame(g){selected=g.n;detail.innerHTML='<div class="gc-detail-mark">N</div><small class="gc-kicker">'+esc(g.c)+'</small><h2>'+esc(g.n)+'</h2><p>'+esc(g.d)+'</p><h3>Quelques conseils</h3>'+g.tips.map((t,i)=>'<div class="gc-tip"><b>'+(i+1)+'.</b> '+esc(t)+'</div>').join('');render()}
function render(){const q=search.value.trim().toLowerCase();const list=games.filter(g=>(category.value==="Tous"||g.c===category.value)&&(g.n.toLowerCase().includes(q)||g.d.toLowerCase().includes(q)||g.tips.some(t=>t.toLowerCase().includes(q))));grid.innerHTML=list.length?list.map((g,i)=>'<article class="gc-card '+(g.n===selected?'active':'')+'" data-game="'+esc(g.n)+'"><div class="gc-card-mark">'+String(i+1).padStart(2,"0")+'</div><small>'+esc(g.c)+'</small><h3>'+esc(g.n)+'</h3><p>'+esc(g.d)+'</p></article>').join(''):'<div class="gc-empty">Aucun jeu trouvé. Essaie un autre mot-clé.</div>';grid.querySelectorAll(".gc-card").forEach(el=>el.addEventListener("click",()=>showGame(games.find(g=>g.n===el.dataset.game))))}
